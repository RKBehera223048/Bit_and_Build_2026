# Server
PORT=3001
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/karens-ear?retryWrites=true&w=majority

# Optional: Groq API Key (system works without it using rule-based extraction)
GROQ_API_KEY=

# Optional: Jev-Omni endpoint (if model server is running)
JEV_OMNI_URL=http://localhost:8000

# CORS
CLIENT_URL=http://localhost:5173
